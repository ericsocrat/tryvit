{
  "name": "tryvit-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "INTEGRATION=1 vitest run rpc-contract",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npx playwright test --project=smoke",
    "test:e2e:visual": "VISUAL_REGRESSION=true npx playwright test",
    "test:e2e:scanner": "npx playwright test authenticated-scanner",
    "quality:smoke": "QA_MODE_LEVEL=smoke npx playwright test tests/quality/ --reporter=html,list",
    "quality:full": "QA_MODE_LEVEL=full npx playwright test tests/quality/ --reporter=html,list",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.js",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.desktop.js",
    "lighthouse": "npm run lighthouse:mobile && npm run lighthouse:desktop",
    "optimize:svg": "svgo -r -f public/icons --config svgo.config.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@marsidev/react-turnstile": "^1.5.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.68.0",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.101.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/speed-insights": "^2.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "sonner": "^1.7.4",
    "tesseract.js": "^5.1.1",
    "web-vitals": "^5.3.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "minimatch": ">=10.2.4",
    "basic-ftp": "5.3.1",
    "uuid": "11.1.1",
    "@eslint/eslintrc": {
      "minimatch": "^3.1.5"
    },
    "serialize-javascript": ">=7.0.3",
    "tmp": ">=0.2.4",
    "sharp": "$sharp",
    "next@16.2.12": {
      "postcss": "8.5.20"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/compat": "^2.1.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0",
    "ws": "^8.21.1"
  }
}
