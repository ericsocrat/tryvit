# Supabase — get these from your project dashboard or `supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only readiness override. Set to "demo" while the production data
# backend is intentionally paused. Omit it when the configured backend is live.
# TRYVIT_DATA_BACKEND_MODE=demo

# Server-owned private-beta admission state. Defaults to invitation-only.
# Set false only to exercise the dormant self-service signup path against a
# local/staging Supabase Auth instance with native CAPTCHA configured.
TRYVIT_PRIVATE_BETA_INVITE_ONLY=true

# No secret keys belong in NEXT_PUBLIC_* variables.
# Service-role key is NEVER exposed to the browser.

# Web Push — VAPID public key (safe to expose to browser)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry — Error telemetry (#183)
# DSN is public (client-side OK per Sentry docs)
# Leave empty to disable telemetry in local development.
NEXT_PUBLIC_SENTRY_DSN=

# Optional: transaction sample rate (0.0 – 1.0, default 0.1 = 10%)
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: structured log level (debug | info | warn | error | fatal)
# LOG_LEVEL=info

# Upstash Redis — Rate limiting (#182)
# Production: set to Upstash Redis REST credentials.
# Development: leave empty to use in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: bypass token for CI / load testing (skip rate limits)
# RATE_LIMIT_BYPASS_TOKEN=

# Admin route protection (#186): comma-separated admin email addresses
# Users not in this list get 403 on /app/admin/* routes.
# ADMIN_EMAILS=admin@example.com

# ── QA Mode ──────────────────────────────────────────────────────────────
# Enables dev-only query observer and debug overlays.
# NEXT_PUBLIC_QA_MODE=true
