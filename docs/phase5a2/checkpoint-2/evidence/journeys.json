      "reference": "scanner",
      "viewport": {
        "width": 390,
        "height": 844
      },
      "locale": "en",
      "theme": "dark",
      "startState": "not-requested",
      "steps": [
        {
          "event": "request-permission-simulation",
          "expectedState": "permission-request",
          "expectedAnnouncement": "No browser prompt is open"
        },
        {
          "event": "grant-simulation",
          "expectedState": "ready",
          "expectedAnnouncement": "Scanner simulation ready"
        },
        {
          "event": "show-acquisition-assist",
          "expectedState": "acquisition-assist",
          "expectedAnnouncement": "Move the package closer"
        },
        {
          "event": "recognize-barcode",
          "expectedState": "recognized",
          "expectedAnnouncement": "Product identity is not matched yet"
        },
        {
          "event": "start-local-lookup",
          "expectedState": "processing",
          "expectedAnnouncement": "local product lookup"
        },
        {
          "event": "lookup-complete",
          "expectedState": "matched",
          "expectedAnnouncement": "North Grain Oat Drink matched"
        }
      ],
      "terminal": {
        "reference": "scanner",
        "state": "matched",
        "focus": "[role='status']",
        "announcement": "North Grain Oat Drink matched"
      }
    }
